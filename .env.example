# Copy this file to .env and fill in real values.
# .env is read locally; on Heroku set the same keys as Config Vars instead.

# --- Database (pick ONE approach) ---

# Option A: full DATABASE_URL (Heroku, Supabase, Neon, Render — all give you a URL).
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# Option B: individual fields (only used if DATABASE_URL is empty)
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=queue_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# --- API auth ---
# Long random string. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every queue request must send header  X-API-Key: <this value>
QUEUE_API_KEY=

# --- Roblox ---
# The place_id of your MATCH place (NOT the lobby). This is what teleport-info returns.
# Find it in Roblox Studio: Game Settings → "Place" tab → numeric ID next to the place name.
MATCH_PLACE_ID=0
